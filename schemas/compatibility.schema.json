{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valkey.io/schemas/examples/compatibility.schema.json",
  "title": "Valkey examples compatibility matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "valkey_versions",
    "languages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "bootstrap",
        "active"
      ]
    },
    "valkey_versions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runtime_versions",
          "reviewers"
        ],
        "properties": {
          "runtime_versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reviewers": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        }
      },
      "then": {
        "properties": {
          "valkey_versions": {
            "minItems": 1
          },
          "languages": {
            "minProperties": 1
          }
        }
      }
    }
  ]
}
