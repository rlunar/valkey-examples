{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valkey.io/schemas/examples/example.schema.json",
  "title": "Valkey example capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "capability",
    "languages",
    "owners",
    "status",
    "valkey",
    "clients",
    "runtime",
    "resources",
    "credentials",
    "network",
    "security_exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100
    },
    "kind": {
      "enum": [
        "cookbook",
        "demo",
        "sample-app"
      ]
    },
    "capability": {
      "enum": [
        "caching",
        "data-structures",
        "messaging-and-streams",
        "migrations-and-integrations",
        "operations",
        "search"
      ]
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "csharp",
          "go",
          "java",
          "javascript",
          "kotlin",
          "php",
          "python",
          "ruby",
          "rust",
          "swift",
          "typescript"
        ]
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "backup"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/githubHandle"
        },
        "backup": {
          "$ref": "#/$defs/githubHandle"
        }
      }
    },
    "status": {
      "enum": [
        "candidate",
        "maintained",
        "deprecated",
        "archived"
      ]
    },
    "valkey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versions",
        "image"
      ],
      "properties": {
        "versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
          }
        },
        "image": {
          "type": "string",
          "pattern": "^[^\\s:]+(?:/[^\\s:@]+)+:[^\\s@]+@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "clients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup",
        "start",
        "verify",
        "reset",
        "stop",
        "timeout_seconds"
      ],
      "properties": {
        "setup": {
          "const": "make setup"
        },
        "start": {
          "const": "make start"
        },
        "verify": {
          "const": "make verify"
        },
        "reset": {
          "const": "make reset"
        },
        "stop": {
          "const": "make stop"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1800
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_cores",
        "memory_mb",
        "disk_mb",
        "download_mb"
      ],
      "properties": {
        "cpu_cores": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 128
        },
        "disk_mb": {
          "type": "integer",
          "minimum": 128
        },
        "download_mb": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_for_default"
      ],
      "properties": {
        "required_for_default": {
          "const": false
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_downloads_after_setup"
      ],
      "properties": {
        "external_downloads_after_setup": {
          "const": false
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_url",
        "minimum_version"
      ],
      "properties": {
        "project_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "minimum_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "security_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason",
          "owner",
          "approved_by",
          "compensating_control",
          "expires"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "$ref": "#/$defs/githubHandle"
          },
          "approved_by": {
            "$ref": "#/$defs/githubHandle"
          },
          "compensating_control": {
            "type": "string",
            "minLength": 1
          },
          "expires": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  },
  "$defs": {
    "githubHandle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    }
  }
}
